{
  "name": "@tempis/timeline",
  "version": "1.2.0",
  "description": "A fast, zero-dependency, canvas-rendered timeline library with smooth interactions, touch support, and TypeScript types.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:esm": "esbuild ./src/index.ts --bundle --sourcemap --format=esm --outfile=dist/index.esm.js",
    "build:node": "esbuild ./src/index.ts --bundle --sourcemap --outdir=dist --platform=node",
    "build:web": "esbuild ./src/index.ts --bundle --sourcemap --platform=browser --global-name=tempis_timeline --outfile=dist/tempis_timeline.js",
    "build:web-watch": "esbuild ./src/index.ts --bundle --watch --sourcemap --platform=browser --global-name=tempis_timeline --outfile=dist/tempis_timeline.js",
    "build:lib-watch": "esbuild ./src/index.ts --bundle --watch --sourcemap --platform=browser --global-name=tempis_timeline --outfile=../../lib/tempis_timeline.js",
    "build:web-minified": "esbuild ./src/index.ts --bundle --minify --platform=browser --global-name=tempis_timeline --outfile=dist/tempis_timeline.min.js --legal-comments=none",
    "build:all": "npm run build && npm run build:esm && npm run build:web && npm run build:web-minified",
    "serve": "http-server -p 8080 -a 0.0.0.0 -c-1",
    "test": "eslint src/ && vitest --run",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run build:all"
  },
  "keywords": [
    "timeline",
    "canvas",
    "chart",
    "gantt",
    "schedule",
    "visualization",
    "interactive",
    "touch",
    "responsive",
    "typescript"
  ],
  "author": "Nikolas Howard",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://tempis.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/tempis-dev/tempis"
  },
  "bugs": {
    "url": "https://github.com/tempis-dev/tempis/issues"
  },
  "sideEffects": false,
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "esbuild": "^0.15.18",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "http-server": "^14.1.1",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.4"
  }
}
