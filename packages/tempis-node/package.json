{
  "name": "@tempis/node",
  "version": "1.0.0",
  "description": "Server-side rendering for Tempis Timeline. Generate timeline images in Node.js without a browser.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "fonts",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:esm": "esbuild ./src/index.ts --bundle --sourcemap --format=esm --platform=node --external:@napi-rs/canvas --external:@tempis/timeline --outfile=dist/index.esm.js",
    "build:cjs": "esbuild ./src/index.ts --bundle --sourcemap --format=cjs --platform=node --external:@napi-rs/canvas --external:@tempis/timeline --outfile=dist/index.js",
    "build:all": "npm run build && npm run build:esm && npm run build:cjs",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "prepublishOnly": "npm run build:all"
  },
  "keywords": [
    "tempis",
    "timeline",
    "canvas",
    "node",
    "ssr",
    "server-side-rendering",
    "image",
    "png",
    "headless"
  ],
  "author": "Nikolas Howard",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://tempis.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/tempis-dev/tempis"
  },
  "bugs": {
    "url": "https://github.com/tempis-dev/tempis/issues"
  },
  "sideEffects": false,
  "peerDependencies": {
    "@tempis/timeline": "^1.2.1"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65"
  },
  "devDependencies": {
    "@tempis/timeline": "*",
    "esbuild": "^0.15.18",
    "typescript": "^5.7.3"
  }
}
